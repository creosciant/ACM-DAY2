{
  "version": 2,
  "buildCommand": "python manage.py migrate --no-input",
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python@4.4.1",
      "config": {
        "pythonVersion": "3.12",
        "requirementsFile": "requirements.txt"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "config.settings",
    "VERCEL": "true"
  }
}